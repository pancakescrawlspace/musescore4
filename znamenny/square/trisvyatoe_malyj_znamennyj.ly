\version "2.26.0"
\include "church_style.ily"
% generated by tools/kievan-ly.py from ../trisvyatoe_malyj_znamennyj.musicxml: square notation
% (Kievan, as in the Synodal chant books), a fourth lower (F major: do on F)

\header {
  title = "Трисвятое"
  composer = "Малый знаменный распев"
}

melody = {
  \clef "kievan-do" \cadenzaOn
c'2 d'1 \bar "||" c'2 d'4\[ e'4\] e'2 d'2 c'2 d'4\[ e'4\] e'2 d'2 c'2 d'4\[
e'4\] \bar "|" e'2 d'1 c'2 d'2 e'1 e'2 d'\longa \bar "kievan"
}

words = \lyricmode {
"А" -- "минь." "Свя" -- "тый" _ "Бо" -- "же," "Свя" -- "тый" _ "Креп" --
"кий," "Свя" -- "тый" _ "Без" -- "смер" -- "тный," "по" -- "ми" -- "луй"
"нас."
}

\score {
  <<
    % the square notes larger than church_style.ily's staff, the lyrics as there
    \new KievanStaff \with { \magnifyStaff #(magstep 3) } \new KievanVoice = "melody" \melody
    \new Lyrics \lyricsto "melody" \words
  >>
  \layout { indent = 0 }
}
