\version "2.26.0"
\include "church_style.ily"
% generated by tools/kievan-ly.py from ../krestu_tvoemu_valaamskij.musicxml: square notation
% (Kievan, as in the Synodal chant books), a fourth lower (F major: do on F)

\header {
  title = "Кресту Твоему"
  composer = "Валаамский напев"
}

melody = {
  \clef "kievan-do" \cadenzaOn
d'4\[ e'4\] f'1 e'2 f'4\[ e'4\] d'1 e'2 f'2 g'2\[ a'2\] g'2 g'2 \bar "|" e'2
f'1\[ e'1\] d'2\[ e'2\] \bar "|" f'1 f'2 e'1 d'1 c'2 d'2 e'2. f'4 e'2 \bar
"|" d'2 c'4\[ d'4 e'2\] d'1\[ c'1\] d'\longa \bar "kievan"
}

words = \lyricmode {
"Крес" _ "ту" "Тво" -- "е" _ "му" "по" -- "кла" -- "ня" _ "ем" -- "ся,"
"Вла" -- "ды" _ "ко," _ "и" "свя" -- "то" -- "е" "Вос" -- "кре" -- "се" --
"ни" -- "е" "Тво" -- "е" _ _ "сла" _ "вим."
}

\score {
  <<
    % the square notes larger than church_style.ily's staff, the lyrics as there
    \new KievanStaff \with { \magnifyStaff #(magstep 3) } \new KievanVoice = "melody" \melody
    \new Lyrics \lyricsto "melody" \words
  >>
  \layout { indent = 0 }
}
