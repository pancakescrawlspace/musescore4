\version "2.26.0"
\include "church_style.ily"
% generated by tools/kievan-ly.py from ../eliczy_znamennyj.musicxml: square notation
% (Kievan, as in the Synodal chant books), a fourth lower (F major: do on F)

\header {
  title = "Елицы"
  composer = "Знаменный распев"
}

melody = {
  \clef "kievan-do" \cadenzaOn
e'2\[ f'2\] g'1 f'2 e'2 e'2 f'4\[ g'4\] f'4\[ e'4\] d'2 e'4\[ f'4\] g'1 \bar
"|" f'4\[ e'4\] f'4\[ g'4\] a'2 \bar "|" a'2 g'4\[ f'4\] g'2 f'2 e'1 \bar
"|" e'2 f'2 g'1 f'1 e'\longa \bar "kievan"
}

words = \lyricmode {
"Е" _ "ли" -- "цы" "во" "Хри" -- "ста" _ "кре" _ "сти" -- "сте" _ "ся," "во"
_ "Хри" _ "ста" "об" -- "ле" _ "ко" -- "сте" -- "ся." "Ал" -- "ли" -- "лу"
-- "и" -- "я."
}

\score {
  <<
    % the square notes larger than church_style.ily's staff, the lyrics as there
    \new KievanStaff \with { \magnifyStaff #(magstep 3) } \new KievanVoice = "melody" \melody
    \new Lyrics \lyricsto "melody" \words
  >>
  \layout { indent = 0 }
}
